# .env.example - 环境变量模板
SITE_URL=http://localhost:8080
COLUMN_WALINE_SERVER_URL=
COLUMN_WALINE_SSO_SECRET=
COLUMN_WALINE_ALLOWED_REDIRECTS=

# Go backend runtime (the PHP config.php values are mapped here one by one).
# Keep LEGACY_PHP_UPSTREAM set only during compatibility/rehearsal; remove it
# before the final PHP shutdown gate.
APP_ADDR=:8080
BACKEND_ROOT=.
APP_ENV=development
RUN_UID=65532
RUN_GID=65532
DB_DRIVER=sqlite
DB_PATH=./data/galgame.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=www_test_map_vnf
DB_USER=www_test_map_vnf
DB_PASS=
DATA_DIR=./data
UPLOAD_DIR=./uploads
WIKI_UPLOAD_DIR=./wiki/uploads
SESSION_LIFETIME=604800
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
LEGACY_PHP_UPSTREAM=
LEGACY_AUTH_ENABLED=true
ADMIN_TOKEN=
BOT_API_KEY=
SESSION_SECRET=
ANALYTICS_HASH_KEY=
QUIZ_LINK_SECRET=
QUIZ_API_KEY=
VNDB_API_URL=https://api.vndb.org/kana
MAKOQUIZ_URL=http://127.0.0.1:3001
RECOGNITION_HMAC_SECRET=
RECOGNITION_CRED_PREFIX=VNF-CRED-
MAIL_DRIVER=mail
MAIL_FROM_NAME=地图
MAIL_FROM_ADDR=noreply@yourdomain.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=ssl
QQ_APPID=
QQ_APPSECRET=
QQ_REDIRECT_URI=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
BANGUMI_CLIENT_ID=
BANGUMI_CLIENT_SECRET=
BANGUMI_REDIRECT_URI=
BANGUMI_OAUTH_URL=https://bgm.tv
BANGUMI_API_URL=https://api.bgm.tv
BANGUMI_TOKEN_ENCRYPTION_KEY=
PICUI_ENABLED=false
PICUI_TOKEN=
PICUI_API_URL=https://picui.cn/api/v1
PICUI_PERMISSION=1
PICUI_TIMEOUT=30
PICUI_FALLBACK_LOCAL=true
PICUI_ALLOWED_HOSTS=picui.cn,www.picui.cn,free.picui.cn
LLM_ENABLED=false
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_API_URL=
LLM_PROXY=
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
